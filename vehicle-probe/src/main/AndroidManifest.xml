<?xml version="1.0" encoding="utf-8"?>
<!-- carlito | DiPlay vehicle probe integration. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="com.geely.desktop.permission.VEHICLE_PROPERTIES" />
    <queries>
        <package android:name="com.geely.desktop.vehicle.bridge" />
    </queries>
    <application>
        <meta-data android:name="com.shilapi.xcertplay.vehicleprobe.author" android:value="carlito" />
        <activity android:name="com.shilapi.xcertplay.vehicleprobe.VehicleProbeActivity"
            android:exported="false" android:process=":vehicle_probe"
            android:label="车辆扫描" android:theme="@style/Theme.VehicleProbe"
            android:resizeableActivity="true" />
        <service android:name="com.shilapi.xcertplay.vehicleprobe.ProbeService"
            android:exported="false" android:process=":vehicle_probe"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
